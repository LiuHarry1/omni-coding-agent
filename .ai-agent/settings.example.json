{
  "models": {
    "large": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "sk-xxx",
      "model": "claude-opus-4.6"
    },
    "medium": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "sk-xxx",
      "model": "claude-sonnet-4.6"
    },
    "small": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "sk-xxx",
      "model": "claude-haiku-4.5"
    }
  },
  "compaction": {
    "enabled": true,
    "contextWindow": 200000,
    "microCompactKeepRecent": 5,
    "maxFilesToRestore": 5,
    "maxTokensPerFile": 5000,
    "fileBudget": 50000,
    "timeBasedMicroEnabled": true,
    "timeBasedMicroGapMinutes": 5
  },
  "sessionMemory": {
    "enabled": true,
    "minimumTokensToInit": 10000,
    "minimumTokensBetweenUpdate": 5000,
    "toolCallsBetweenUpdates": 3,
    "cacheSafe": true,
    "modelTier": "medium",
    "compactMinTokens": 10000,
    "compactMaxTokens": 40000,
    "compactMinTextMessages": 5
  },
  "autoMemory": {
    "enabled": true,
    "prefetchEnabled": true,
    "cacheSafe": true,
    "modelTier": "medium",
    "prefetchModelTier": "small"
  },
  "lspServers": {
    "typescript": {
      "command": "npx",
      "args": ["--yes", "typescript-language-server", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      },
      "startupTimeout": 30000
    },
    "python": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "pyright",
        "pyright-langserver",
        "--stdio"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeout": 30000
    },
    "java-language-server": {
      "command": "npx",
      "args": ["--yes", "jj-language-server", "--stdio"],
      "extensionToLanguage": {
        ".java": "java"
      },
      "startupTimeout": 30000
    },
    "jdtls": {
      "command": "jdtls",
      "args": ["-data", ".jdtls-data"],
      "_extensionToLanguage": {
        ".java": "java"
      },
      "startupTimeout": 120000
    },
    "stpl": {
      "command": "node",
      "args": ["integrations/stpl-lsp-bridge/index.js"],
      "env": {
        "STPL_START_MODE": "jmx",
        "STPLLS_PID": "REPLACE_WITH_HOST_JVM_PID",
        "STPL_JMX_OBJECT_NAME": "com.xxx.stpl:type=basic,name=console",
        "STPL_JMX_HELPER": "integrations/stpl-lsp-bridge/jmx-helper/StplJmxHelper.java",
        "STPL_JMX_JAVA": "/usr/lib/jvm/java-25/bin/java",
        "STPL_CONNECT_TIMEOUT_MS": "60000"
      },
      "extensionToLanguage": {
        ".spec": "stpl",
        ".flow": "stpl",
        ".dbd": "stpl",
        ".prog": "stpl",
        ".seq": "stpl",
        ".pat": "stpl"
      },
      "startupTimeout": 120000,
      "maxRestarts": 1
    }
  },
  "environments": {
    "ssh": [{ "sshHost": "yourhost", "startDirectory": "~/yourworkspace" }]
  },

  "browser": {
    "mode": "isolated",
    "enabled": false,
    "restoreTabAfterInput": false
  },

  "mcpServers": {},
  "disabledTools": [],

  "scheduledTasks": {
    "enabled": true
  },

  "agents": {
    "picker": {
      "modes": ["agent"],
      "primaries": ["browser"]
    },
    "default": {
      "mode": "agent",
      "agentType": "browser"
    }
  },

  "permissions": {
    "defaultMode": "dontAsk",
    "allow": ["Read(docs/**)"],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)"
    ],
    "additionalDirectories": [
      "C:\\Users\\Harry",
      "~/Projects",
      "D:\\shared"
    ]
  }
}
