# Dependencies (root + every npm workspace)
node_modules/

# Environment & secrets
.env
.env.*
!.env.example

# Local agent / session state. `.ai-agent/` itself is tracked (example
# skills/agents/commands + settings.example.json); only per-machine files
# are ignored.
.ai-agent/settings.json
.ai-agent/settings.local.json
.ai-agent/settings-*.json
.ai-agent/plans/
.ai-agent/agent-memory-local/
.managed-demo/
# Legacy session dir (pre ~/.ai-agent/projects); ignore if leftover.
.sessions/
sessions/

# Frontend & desktop build outputs
web/dist/
dist/
dist-desktop/
docs/.vitepress/cache/
docs/.vitepress/dist/

# Source maps (generated by esbuild / bundlers)
*.cjs.map
*.js.map
*.mjs.map

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Logs & temp
*.log
agent-stderr.log
*.tmp
*.temp
coverage/
coding-tools-ui-e2e-*/
.workspace-seeded

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Chrome extension pack output (private signing keys)
extension.crx
extension.pem
chrome-extension.crx
chrome-extension.pem

# Deployment secrets
deploy/.env

# Leftover SWE-bench output. Source lives in evals/swe-bench/; this tree is
# cloned workspaces, runs, and logs and must stay local.
eval/
