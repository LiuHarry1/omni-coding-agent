{
  "models": {
    "large": {
      "provider": "anthropic",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "claude-fable-5.1"
    },
    "medium": {
      "provider": "anthropic",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "not-needed",
      "model": "claude-fable-5.1"
    },
    "small": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "apiKey": "xxx",
      "model": "qwen3.6-35b-a3b"
    }
  },
  "compaction": {
    "enabled": true,
    "contextWindow": 262144,
    "maxOutputTokens": 16384,
    "microCompactKeepRecent": 5,
    "maxFilesToRestore": 5,
    "maxTokensPerFile": 5000,
    "fileBudget": 50000,
    "timeBasedMicroEnabled": true,
    "timeBasedMicroGapMinutes": 5
  },
  "sessionMemory": {
    "enabled": true,
    "minimumTokensToInit": 10000,
    "minimumTokensBetweenUpdate": 20000,
    "toolCallsBetweenUpdates": 15,
    "cacheSafe": true,
    "modelTier": "small",
    "compactMinTokens": 10000,
    "compactMaxTokens": 40000,
    "compactMinTextMessages": 5
  },
  "autoMemory": {
    "enabled": true,
    "prefetchEnabled": true,
    "cacheSafe": false,
    "modelTier": "small",
    "prefetchModelTier": "small"
  },
  "lspServers": {
    "typescript": {
      "command": "npx",
      "args": ["--yes", "typescript-language-server", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact"
      },
      "startupTimeout": 30000
    },
    "python": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "pyright",
        "pyright-langserver",
        "--stdio"
      ],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeout": 30000
    },
    "java-language-server": {
      "command": "npx",
      "args": ["--yes", "jj-language-server", "--stdio"],
      "extensionToLanguage": {
        ".java": "java"
      },
      "startupTimeout": 30000
    }
  },

  "scheduledTasks": {
    "enabled": false
  },

  "browser": {
    "enabled": false
  },
  "marketplaces": {
    "providers": [
      {
        "id": "skills-sh",
        "type": "skills-sh",
        "label": "skills.sh",
        "baseURL": "https://skills.sh/api",
        "auth": "none",
        "capabilities": ["skills"]
      }
    ]
  }
}
