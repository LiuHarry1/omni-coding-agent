# syntax=docker/dockerfile:1
#
# WORKSPACE image — the per-workspace container for cloud mode
# (CLOUD_WORKSPACES=docker). The control plane runs one container per
# workspace from this image and talks to the baked Worker over
# `docker exec -i`. User code, shells and git run here, never in the agent.
#
# Build from repo root (after `npm run build:worker`):
#   docker build -f deploy/Dockerfile.workspace -t agent-workspace:latest .
#
# Runtime contract (enforced by the control plane, not this file):
#   - runs as uid 1000 with all capabilities dropped and no-new-privileges
#   - only /workspace persists (a named volume per workspace); the repository
#     is cloned into /workspace/repo. Everything else is reset when an idle
#     container is removed and recreated from the latest image.
#   - no secrets in the environment; only variables passed per exec

FROM node:22-bookworm-slim

# Office/PDF tooling: chat attachments (docx, xlsx, pptx, doc, xls, pdf) are
# copied into the workspace and converted here with Bash.
RUN apt-get update && apt-get install -y --no-install-recommends \
    antiword \
    build-essential \
    ca-certificates \
    catdoc \
    curl \
    file \
    fontconfig \
    fonts-dejavu-core \
    fonts-wqy-zenhei \
    git \
    jq \
    less \
    pandoc \
    patch \
    poppler-utils \
    procps \
    python3 \
    python3-docx \
    python3-lxml \
    python3-matplotlib \
    python3-openpyxl \
    python3-pandas \
    python3-pil \
    python3-pypdf \
    python3-venv \
    python3-pip \
    python3-xlrd \
    python-is-python3 \
    ripgrep \
    unzip \
    zip \
  && rm -rf /var/lib/apt/lists/*

# bookworm ships no python3-pptx package.
RUN pip install --no-cache-dir --break-system-packages python-pptx \
  && python3 -c "import docx, openpyxl, pptx, pypdf, xlrd"

# Presentation authoring and visual-QA runtime. Keep these packages pinned so
# Skills never need network access or package installation while they run.
RUN npm install --prefix /opt/pptx-tools --omit=dev --no-audit --no-fund \
      pptxgenjs@4.0.1 \
      sharp@0.33.5 \
      skia-canvas@4.0.0 \
      linebreak@2.0.0 \
      fontkit@2.0.4 \
  && NODE_PATH=/opt/pptx-tools/node_modules node -e \
      "require('pptxgenjs'); require('sharp'); require('skia-canvas'); require('linebreak'); require('fontkit');"

# The node image's uid 1000 user becomes `agent`, matching `--user 1000:1000`.
RUN groupmod --new-name agent node \
  && usermod --login agent --home /home/agent --move-home node \
  && mkdir -p /workspace \
  && chown agent:agent /workspace

# Refuse local-file and ext:: transports for every repository by default.
RUN git config --system protocol.file.allow user \
  && git config --system protocol.ext.allow never \
  && git config --system init.defaultBranch main

COPY dist/worker/ /opt/agent/dist/worker/

# Fail the image build instead of publishing a workspace that cannot start its
# coding worker. Exactly one branded worker bundle is expected.
RUN set -eu; \
  worker_count="$(find /opt/agent/dist/worker -maxdepth 1 -type f -name '*-worker.cjs' | wc -l)"; \
  test "$worker_count" -eq 1; \
  worker="$(find /opt/agent/dist/worker -maxdepth 1 -type f -name '*-worker.cjs' -print -quit)"; \
  test -s "$worker"; \
  node --check "$worker"

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    AGENT_ROOT=/opt/agent/dist/worker \
    NODE_PATH=/opt/pptx-tools/node_modules \
    HOME=/home/agent

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
