{
  "models": {
    "large": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "model": "claude-opus-5.5"
    },
    "medium": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "model": "claude-opus-5.5"
    },
    "small": {
      "provider": "openai-compatible",
      "baseURL": "http://localhost:4141/v1",
      "model": "claude-sonnet-5.5"
    }
  },
  "compaction": {
    "enabled": true,
    "contextWindow": 200000,
    "microCompactKeepRecent": 5,
    "maxFilesToRestore": 5,
    "maxTokensPerFile": 5000,
    "fileBudget": 50000,
    "timeBasedMicroEnabled": true,
    "timeBasedMicroGapMinutes": 5
  },
  "sessionMemory": {
    "enabled": true,
    "minimumTokensToInit": 10000,
    "minimumTokensBetweenUpdate": 5000,
    "toolCallsBetweenUpdates": 3,
    "cacheSafe": true,
    "modelTier": "medium",
    "compactMinTokens": 10000,
    "compactMaxTokens": 40000,
    "compactMinTextMessages": 5
  },
  "autoMemory": {
    "enabled": true,
    "prefetchEnabled": true,
    "cacheSafe": true,
    "modelTier": "medium",
    "prefetchModelTier": "medium"
  },
  "agents": {
    "picker": {
      "modes": ["agent"],
      "primaries": ["desktop", "browser", "assistant"]
    },
    "default": {
      "mode": "agent",
      "agentType": "desktop"
    }
  },
  "browser": {
    "mode": "extension",
    "relayPort": 8766,
    "enabled": true
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "mcpServers": {
    "cua-driver": {
      "command": "cua-driver",
      "args": ["mcp"]
    }
  },
  "disabledTools": []
}
