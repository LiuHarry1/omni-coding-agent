# syntax=docker/dockerfile:1
#
# TENANT image — thin layer on top of ai-agent-base that bakes ONE
# project's config (.ai-agent/) into the image. Rebuilding this image
# after a config change is a few seconds because every heavy layer
# lives in the base image.
#
# Usage from repo root:
#
#   1. Build the base image (slow — only when agent code changes):
#        npm run build:worker
#        docker build -f deploy/Dockerfile.agent-base -t ai-agent-base:latest .
#
#   2. Edit platform policy under `deploy/managed/` (managed-settings.json,
#      AGENTS.md, .ai-agent/{skills,agents,...}). Do not bake repo-root
#      `.ai-agent/` into the image.
#
#   3. Build the tenant image (from repo root):
#        docker build -f deploy/Dockerfile.agent-tenant \
#          -t ai-agent-tenant:latest .
#      To use a published base, add:
#        --build-arg BASE_IMAGE=registry.example.com/ai-agent-base:latest
#
#   4. Run via compose (which already references ai-agent-tenant:latest):
#        docker compose -f deploy/docker-compose.admin.yml up -d
#
# Secrets:
#   DO NOT commit API keys into managed-settings.json — they will end up in
#   image layers and are recoverable via `docker history` even if a later
#   layer overwrites them. Prefer env injection at runtime (compose .env).

ARG BASE_IMAGE=ai-agent-base:latest
FROM ${BASE_IMAGE}

# UTF-8 locale — agent logs include CJK user text; a non-UTF-8 locale makes
# in-container shells/pagers (docker exec + less, etc.) show <E4><BD>… bytes.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ── Managed / policy (CC getManagedFilePath) → /etc/ai-agent ───────────────
# All platform bake content lives under deploy/managed/ (not project .ai-agent/).
COPY deploy/managed/managed-settings.json /etc/ai-agent/managed-settings.json
COPY deploy/managed/AGENTS.md /etc/ai-agent/AGENTS.md
COPY deploy/managed/.ai-agent/ /etc/ai-agent/.ai-agent/

# Per-user workspace template — copied on first SSO login into
# /workspace/users/<slug>/. User-visible agents/skills go here — not /etc.
COPY deploy/workspace-seed/ /opt/workspace-seed/

# Optional: override the default CMD from the base image.
# CMD ["./node_modules/.bin/tsx", "start.js"]
