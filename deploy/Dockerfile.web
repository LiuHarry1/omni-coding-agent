# syntax=docker/dockerfile:1
#
# Frontend image: builds the Vite UI, then serves it as a STATIC site from
# nginx (no reverse proxy — the SPA calls the agent cross-origin via API_BASE).
# Pair with deploy/Dockerfile.agent-tenant via deploy/docker-compose.admin.yml or
# deploy/docker-compose.sso.yml.
#
# Build from repo root:
#   docker build -f deploy/Dockerfile.web -t ai-agent-web:latest .

FROM node:22-bookworm-slim AS build
# Keep repo-relative layout so vite.config.js / src/lib/brand.js can resolve
# ../brand.json and ../../../brand.json from web/.
WORKDIR /src
COPY brand.json ./brand.json
# `web` is an npm workspace of the root package: the lockfile lives at the
# repo root and every workspace manifest must be present for `npm ci`.
COPY package.json package-lock.json ./
COPY web/package.json ./web/
COPY protocol/package.json ./protocol/
COPY sdks/typescript/package.json ./sdks/typescript/
RUN npm ci --ignore-scripts -w web
COPY web/ ./web/
RUN npm run build -w web

FROM nginx:alpine
# `htpasswd` (apache2-utils) is used by the startup script to hash the
# optional Basic Auth password from the WEB_PASSWORD env var.
RUN apk add --no-cache apache2-utils
# Static assets live where nginx.static.conf points its `root` directive.
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.static.conf /etc/nginx/conf.d/default.conf
# Startup hook: the stock nginx entrypoint runs *.sh in this dir before
# launching nginx. It (re)generates auth.inc from WEB_PASSWORD on every
# `docker run` / `compose up`, so the password is a RUNTIME setting — no
# rebuild needed to change it, and it never lands in `docker history`.
COPY deploy/web-auth.sh /docker-entrypoint.d/40-web-auth.sh
# Runtime SPA config — regenerates app-config.js from AUTH_ENABLED / API_BASE /
# AUTH_BASE / REMOTE_ENABLED so one image serves every deploy mode without a rebuild.
COPY deploy/web-runtime-config.sh /docker-entrypoint.d/45-web-runtime-config.sh
# Pre-create the empty auth include so `nginx -t` is valid before the hook
# runs, strip any CRLF (scripts may be authored on Windows), make runnable.
RUN touch /etc/nginx/conf.d/auth.inc \
 && sed -i 's/\r$//' /docker-entrypoint.d/40-web-auth.sh /docker-entrypoint.d/45-web-runtime-config.sh \
 && chmod +x /docker-entrypoint.d/40-web-auth.sh /docker-entrypoint.d/45-web-runtime-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
