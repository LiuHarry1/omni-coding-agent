# syntax=docker/dockerfile:1
#
# Agent BASE image — runtime + agent code, NO project config.
#
# This image is the slow-changing half: Node 22, Python venv, npm deps,
# pip deps, and the agent's TypeScript source. It is published once per
# agent-code release and consumed by thin "tenant" images that COPY in
# a project-specific `.ai-agent/` directory (config.json, agents,
# skills, slash commands). See `deploy/Dockerfile.agent-tenant` for the
# tenant pattern and `deploy/README.md` for the full workflow.
#
# Build from repo root:
#   npm run build:worker
#   docker build -f deploy/Dockerfile.agent-base -t ai-agent-base:latest .
#
# Notes for downstream tenant Dockerfiles:
#   - `WORKDIR /app` and tsx are already set up; `CMD` defaults to
#     `start.js` and need not be overridden.
#   - `/root/.ai-agent` is the agent config directory. The tenant image
#     should `COPY` its own contents there (NOT mount at runtime —
#     mounting defeats the point of baking the tenant layer).
#   - `/workspace` is the default project root the agent operates on.
#     Bind-mount your host project tree onto this path at runtime.

FROM node:22-bookworm-slim
WORKDIR /app

# System packages (single apt layer for cache efficiency).
# Required — agent runtime / shell tools will fail without these:
#   ca-certificates  HTTPS / TLS for outbound calls
#   curl             HTTP from shell scripts and health checks
#   git              repo ops (clone, status, diff, commit)
#   python3*         bash tool invokes python/pip via the venv below
# Optional — improve capability or speed; agent can degrade without them:
#   ripgrep          grep/glob tools; without it falls back to Node
#                    (ripgrep-fallback.ts). See RG_FALLBACK in .env.example.
#   poppler-utils    pdfinfo / pdftotext / pdftoppm — Read(PDF) renders pages
#                    to JPEG via pdftoppm when the model lacks native PDF input
#   fonts-*          matplotlib chart labels (Latin + CJK) in headless Agg
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- required ---
    ca-certificates \
    curl \
    git \
    python3 \
    python3-venv \
    python3-pip \
    python-is-python3 \
    # --- optional ---
    ripgrep \
    poppler-utils \
    fonts-dejavu-core \
    fonts-wqy-zenhei \
  && rm -rf /var/lib/apt/lists/*

# Docker CLI only (no daemon): cloud mode (CLOUD_WORKSPACES=docker) drives
# per-workspace containers through the host socket mounted by compose.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker

# Python 3.11 + venv so the agent's bash tool can invoke python/pip
# without polluting the system site-packages.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
# Bash tool uses `bash -lc` (login shell). Debian `/etc/profile` resets PATH
# and would hide /opt/venv — so matplotlib/`python` fail with ModuleNotFoundError
# even though the venv has the packages. profile.d runs after that reset.
RUN printf '%s\n' \
    '# Keep agent Python venv on PATH for login shells (bash -lc).' \
    'if [ -d /opt/venv/bin ]; then' \
    '  case ":$PATH:" in' \
    '    *:/opt/venv/bin:*) ;;' \
    '    *) PATH="/opt/venv/bin:$PATH" ;;' \
    '  esac' \
    '  export PATH' \
    '  export VIRTUAL_ENV=/opt/venv' \
    'fi' \
    > /etc/profile.d/ai-agent-venv.sh \
  && chmod 644 /etc/profile.d/ai-agent-venv.sh
COPY deploy/requirements.txt ./
RUN python3 -m venv "${VIRTUAL_ENV}" \
  && pip install --no-cache-dir --default-timeout=600 --upgrade pip \
  && pip install --no-cache-dir --default-timeout=600 -r requirements.txt \
  && python -c "import matplotlib; print('[agent-base] matplotlib', matplotlib.__version__)" \
  && python -c "import mcp_server_fetch; print('[agent-base] mcp_server_fetch', mcp_server_fetch.__file__)"

COPY package.json package-lock.json ./
# The root package declares npm workspaces (web, protocol, sdks/typescript).
# Only the root runtime deps are needed here: --workspaces=false keeps the
# UI / SDK dependency trees out of the agent image.
# Runtime needs tsx to load TypeScript sources; keep prod deps lean.
RUN npm ci --omit=dev --workspaces=false \
  && npm install --no-save --ignore-scripts tsx@^4.21.0 \
  && test -x node_modules/.bin/tsx \
  && npm cache clean --force

COPY src/ ./src/
# Shared wire-protocol package, imported by the server transports at
# runtime (tsx loads its .ts directly; zod resolves from /app/node_modules).
COPY protocol/ ./protocol/
COPY start.js ./
# Product branding - imported by src/brand.ts as ../brand.json
COPY brand.json ./brand.json
# Bundled remote/local worker used by execution plane (slug from brand.json)
COPY dist/worker/ ./dist/worker/

# Pre-create the config dir so tenant images can COPY into it without
# worrying about directory existence / ownership.
RUN mkdir -p /root/.ai-agent /opt/workspace-seed

ENV NODE_ENV=production
ENV PORT=4567
# Default workspace inside the container. The tenant deployment is expected
# to bind-mount the host project tree at this path (see docker-compose.admin.yml).
# Override per-instance via `-e WORKSPACE=/other` or `--workspace=/path`.
ENV WORKSPACE=/workspace
VOLUME /workspace
EXPOSE 4567

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||4567)+'/health',(r)=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["./node_modules/.bin/tsx", "start.js"]
