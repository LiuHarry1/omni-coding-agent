# ---------------------------------------------------------------------------
# Example env file. Copy to `.env` and fill in real values.
# Loaded automatically by `start.js` via Node's built-in process.loadEnvFile.
#
# Model providers / auto-memory / compaction thresholds live in
# `.ai-agent/settings.json` (and ~/.ai-agent/settings.json) — not here.
#
# Filesystem permissions (desktop File tools). In settings.json:
#   "permissions": {
#     "defaultMode": "dontAsk",
#     "allow": ["Read(docs/**)"],
#     "deny": ["Read(.env)", "Edit(.env)", "Write(.env)"],
#     "additionalDirectories": ["C:\\Users\\Harry"]
#   }
# defaultMode: default | acceptEdits | plan | dontAsk | bypassPermissions
#   default/acceptEdits/plan = ask outside workspace; dontAsk = deny outside;
#   bypassPermissions = allow outside (deny rules still apply). SSO AUTH forces dontAsk.
# additionalDirectories = extra allowed trees (UI Always allow also writes this).
# deny always wins. SSO AUTH already implies dontAsk; ignores allow + additionalDirectories.
# ---------------------------------------------------------------------------

# === Server ==================================================================
# HTTP port for the SSE server. Default: 4567.
PORT=3000

# === Workspace ===============================================================
# Default project root when a request omits `workspace`.
# Priority: CLI --workspace=… → WORKSPACE → process cwd.
# WORKSPACE=

# === Ripgrep / Grep / Glob ===================================================
# Packaged Windows/macOS desktop builds prefer their verified bundled ripgrep.
# Development and remote workers use `rg` from PATH when available.
# RG_FALLBACK: unset = bundled/PATH rg then Node fallback; force = always Node;
# off = require a working bundled/PATH rg.
# RG_FALLBACK=
# RG_TIMEOUT_SECONDS=20

# Glob/grep listing defaults (both default true when unset).
GLOB_NO_IGNORE=true
GLOB_HIDDEN=true

# === Web search ==============================================================
# exa (default) | searxng
WEB_SEARCH_PROVIDER=exa
# SEARXNG_URL=http://localhost:8888
# EXA_API_KEY=

# === Agent loop ==============================================================
# Max tokens per model step. Default when unset: 16384.
# settings.json compaction.maxOutputTokens takes precedence over this.
# AGENT_MAX_OUTPUT_TOKENS=65536

# Dump LLM request/response JSONL. Off unless 1/true.
# DUMP_PROMPTS=1
# DUMP_PROMPTS_DIR=/tmp/dump-prompts-live

# === Auto-compaction overrides (optional; settings.json is primary) ==========
# DISABLE_AUTO_COMPACT=1
# COMPACT_CONTEXT_WINDOW=200000
# COMPACT_MICRO_KEEP=5

# === Analytics (optional — off unless ANALYTICS_URL is set) ==================
# ANALYTICS_URL=http://localhost:8200
# ANALYTICS_INGEST_API_KEY=
# ANALYTICS_FLUSH_MS=5000

# === Daily token quota (SSO cloud — optional) ================================
# Requires AUTH_ENABLED on deploy + analytics with a daily limit.
# QUOTA_ENABLED=true
